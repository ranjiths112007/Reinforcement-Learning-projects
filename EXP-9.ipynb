    "# EXP-9: Probabilistic model-based planning with an ensemble and CEM\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "torch.manual_seed(7)\n",
    "np.random.seed(7)\n",
    "\n",
    "# Small noisy environment: the goal is to keep the state close to zero.\n",
    "def step_env(state, action):\n",
    "    noise = np.random.normal(0, 0.03)\n",
    "    next_state = state + action + noise\n",
    "    reward = -(next_state ** 2)\n",
    "    return next_state, reward\n",
    "\n",
    "class ProbNet(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(2, 32),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(32, 2)\n",
    "        )\n",
    "\n",
    "    def forward(self, state, action):\n",
    "        x = torch.cat([state, action], dim=-1)\n",
    "        out = self.net(x)\n",
    "        return out[:, 0:1], out[:, 1:2]\n",
    "\n",
    "    def loss(self, state, action, next_state):\n",
    "        mean, logvar = self.forward(state, action)\n",
    "        var = torch.exp(logvar).clamp_min(1e-5)\n",
    "        return (0.5 * ((next_state - mean) ** 2 / var + logvar)).mean()\n",
    "\n",
    "N_MODELS = 3\n",
    "models = [ProbNet() for _ in range(N_MODELS)]\n",
    "optimizers = [torch.optim.Adam(m.parameters(), lr=1e-2) for m in models]\n",
    "\n",
    "def train_ensemble(states, actions, next_states, epochs=60):\n",
    "    n = len(states)\n",
    "    for model, optimizer in zip(models, optimizers):\n",
    "        idx = np.random.randint(0, n, n)\n",
    "        s = torch.tensor(states[idx], dtype=torch.float32).unsqueeze(1)\n",
    "        a = torch.tensor(actions[idx], dtype=torch.float32).unsqueeze(1)\n",
    "        s2 = torch.tensor(next_states[idx], dtype=torch.float32).unsqueeze(1)\n",
    "        for _ in range(epochs):\n",
    "            optimizer.zero_grad()\n",
    "            loss = model.loss(s, a, s2)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "def imagine_next_state(state, action):\n",
    "    model = models[np.random.randint(N_MODELS)]\n",
    "    s = torch.tensor([[state]], dtype=torch.float32)\n",
    "    a = torch.tensor([[action]], dtype=torch.float32)\n",
    "    with torch.no_grad():\n",
    "        mean, logvar = model(s, a)\n",
    "        std = torch.exp(0.5 * logvar)\n",
    "        sample = mean + std * torch.randn_like(mean)\n",
    "    return sample.item()\n",
    "\n",
    "def cem_plan(state, horizon=4, candidates=60, elites_count=8, iterations=3):\n",
    "    mean = np.zeros(horizon)\n",
    "    std = np.ones(horizon)\n",
    "    for _ in range(iterations):\n",
    "        sequences = np.random.normal(mean, std, size=(candidates, horizon))\n",
    "        scores = np.zeros(candidates)\n",
    "        for i, sequence in enumerate(sequences):\n",
    "            sim_state = state\n",
    "            for action in sequence:\n",
    "                sim_state = imagine_next_state(sim_state, action)\n",
    "                scores[i] += -(sim_state ** 2)\n",
    "        elite = sequences[np.argsort(scores)[-elites_count:]]\n",
    "        mean = elite.mean(axis=0)\n",
    "        std = elite.std(axis=0) + 1e-3\n",
    "    return mean[0]\n",
    "\n",
    "# Build a small exploration dataset.\n",
    "state = np.random.uniform(-4, 4)\n",
    "states, actions, next_states = [], [], []\n",
    "for _ in range(120):\n",
    "    action = np.random.uniform(-1, 1)\n",
    "    next_state, _ = step_env(state, action)\n",
    "    states.append(state)\n",
    "    actions.append(action)\n",
    "    next_states.append(next_state)\n",
    "    state = next_state\n",
    "\n",
    "train_ensemble(np.array(states), np.array(actions), np.array(next_states))\n",
    "\n",
    "state = 3.5\n",
    "print(f"Initial state: {state:.2f}")\n",
    "for t in range(8):\n",
    "    action = cem_plan(state)\n",
    "    next_state, reward = step_env(state, action)\n",
    "    print(f"t={t:2d} | state={state:5.2f} | action={action:5.2f} | reward={reward:5.2f}")\n",
    "    state = next_state\n",
    "print(f"Final state: {state:.2f}")"
   ]
