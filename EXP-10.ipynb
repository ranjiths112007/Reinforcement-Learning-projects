    "# EXP-10: Simplified MADDPG-style multi-agent learning\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "\n",
    "np.random.seed(11)\n",
    "torch.manual_seed(11)\n",
    "\n",
    "class SimpleDefenseEnv:\n",
    "    def __init__(self, n_agents=3):\n",
    "        self.n_agents = n_agents\n",
    "        self.obs_dim = 1\n",
    "        self.action_dim = 1\n",
    "\n",
    "    def reset(self):\n",
    "        self.positions = np.random.uniform(-5, 5, size=self.n_agents)\n",
    "        return [np.array([p]) for p in self.positions]\n",
    "\n",
    "    def step(self, actions):\n",
    "        for i in range(self.n_agents):\n",
    "            self.positions[i] += float(actions[i][0])\n",
    "        reward = -float(np.sum(np.abs(self.positions)))\n",
    "        rewards = [reward] * self.n_agents\n",
    "        next_obs = [np.array([p]) for p in self.positions]\n",
    "        return next_obs, rewards, False\n",
    "\n",
    "class Actor(nn.Module):\n",
    "    def __init__(self, obs_dim=1, action_dim=1):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(obs_dim, 48),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(48, 32),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(32, action_dim),\n",
    "            nn.Tanh()\n",
    "        )\n",
    "\n",
    "    def forward(self, obs):\n",
    "        return self.net(obs)\n",
    "\n",
    "class CentralizedCritic(nn.Module):\n",
    "    def __init__(self, obs_dim, action_dim):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(obs_dim + action_dim, 96),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(96, 48),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(48, 1)\n",
    "        )\n",
    "\n",
    "    def forward(self, joint_obs, joint_actions):\n",
    "        return self.net(torch.cat([joint_obs, joint_actions], dim=-1))\n",
    "\n",
    "class Agent:\n",
    "    def __init__(self, total_obs, total_actions):\n",
    "        self.actor = Actor()\n",
    "        self.critic = CentralizedCritic(total_obs, total_actions)\n",
    "        self.actor_optimizer = optim.Adam(self.actor.parameters(), lr=1e-3)\n",
    "        self.critic_optimizer = optim.Adam(self.critic.parameters(), lr=1e-3)\n",
    "\n",
    "    def select_action(self, obs, noise=0.08):\n",
    "        obs_t = torch.tensor(obs, dtype=torch.float32).unsqueeze(0)\n",
    "        action = self.actor(obs_t).detach().numpy()[0]\n",
    "        action += noise * np.random.randn(*action.shape)\n",
    "        return np.clip(action, -1, 1)\n",
    "\n",
    "def train(num_episodes=150, gamma=0.95):\n",
    "    env = SimpleDefenseEnv(n_agents=3)\n",
    "    n = env.n_agents\n",
    "    total_obs = env.obs_dim * n\n",
    "    total_actions = env.action_dim * n\n",
    "    agents = [Agent(total_obs, total_actions) for _ in range(n)]\n",
    "    mse = nn.MSELoss()\n",
    "\n",
    "    print("Training a 3-agent cooperative system...")\n",
    "    for episode in range(num_episodes):\n",
    "        obs = env.reset()\n",
    "        actions = [agents[i].select_action(obs[i]) for i in range(n)]\n",
    "        next_obs, rewards, _ = env.step(actions)\n",
    "\n",
    "        joint_obs = torch.tensor(np.concatenate(obs), dtype=torch.float32).unsqueeze(0)\n",
    "        joint_next_obs = torch.tensor(np.concatenate(next_obs), dtype=torch.float32).unsqueeze(0)\n",
    "        joint_actions = torch.tensor(np.concatenate(actions), dtype=torch.float32).unsqueeze(0)\n",
    "        next_actions = torch.cat([agents[i].actor(torch.tensor(next_obs[i], dtype=torch.float32).unsqueeze(0)) for i in range(n)], dim=-1)\n",
    "\n",
    "        for i in range(n):\n",
    "            with torch.no_grad():\n",
    "                target_q = rewards[i] + gamma * agents[i].critic(joint_next_obs, next_actions)\n",
    "            current_q = agents[i].critic(joint_obs, joint_actions)\n",
    "            critic_loss = mse(current_q, target_q)\n",
    "            agents[i].critic_optimizer.zero_grad()\n",
    "            critic_loss.backward()\n",
    "            agents[i].critic_optimizer.step()\n",
    "\n",
    "            local_obs = torch.tensor(obs[i], dtype=torch.float32).unsqueeze(0)\n",
    "            own_action = agents[i].actor(local_obs)\n",
    "            grad_actions = []\n",
    "            for j in range(n):\n",
    "                if j == i:\n",
    "                    grad_actions.append(own_action)\n",
    "                else:\n",
    "                    grad_actions.append(torch.tensor(actions[j], dtype=torch.float32).unsqueeze(0))\n",
    "            actor_actions = torch.cat(grad_actions, dim=-1)\n",
    "            actor_loss = -agents[i].critic(joint_obs, actor_actions).mean()\n",
    "            agents[i].actor_optimizer.zero_grad()\n",
    "            actor_loss.backward()\n",
    "            agents[i].actor_optimizer.step()\n",
    "\n",
    "        if (episode + 1) % 25 == 0:\n",
    "            print(f"Episode {episode + 1}/{num_episodes} | Average reward: {np.mean(rewards):.3f}")\n",
    "\n",
    "    return agents\n",
    "\n",
    "trained_agents = train()\n",
    "print("\\nTraining complete. Each agent uses a local Actor and a centralized Critic.")"
   ]
  }
